# Copy this file to backend\.env and update the database password and signing key.
DATABASE_URL=postgresql+psycopg://campuscare:change-this-password@127.0.0.1:5432/campuscare
JWT_SECRET=replace-with-a-random-secret-before-deployment
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# UPLOAD_DIR defaults to backend\uploads
